generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  engineType      = "none"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// datasource db {
//   provider = "sqlite"
//   url      = "file:./jobberdata"
// }

model Client {
  companyName              String?
  createdAt                DateTime
  firstName                String?
  id                       String           @id
  isArchivable             Boolean
  isArchived               Boolean
  isCompany                Boolean
  isLead                   Boolean
  lastName                 String?
  name                     String?
  title                    String?
  updatedAt                DateTime
  jobberWebUri             String?
  balance                  Float?
  billingStreet            String?
  billingStreet1           String?
  billingStreet2           String?
  billingCity              String?
  billingProvince          String?
  billingPostalCode        String?
  billingCountry           String?
  leadSource               String?
  sourceText               String?
  sourceMetadata           Json?
  utmMedium                String?
  secondaryName            String?
  receivesFollowUps        Boolean?
  receivesInvoiceFollowUps Boolean?
  receivesQuoteFollowUps   Boolean?
  receivesReminders        Boolean?
  receivesReviewRequests   Boolean?
  phones                   Json?
  emails                   Json?
  tags                     String[]
  customFields             Json?
  invoices                 Invoice[]
  jobs                     Job[]
  quotes                   Quote[]
  payments                 Payment[]
  property                 Property[]
  timeSheetEntries         TimeSheetEntry[] @relation("TimeSheetEntryToClient")
}

model Expense {
  createdAt        DateTime
  date             DateTime
  description      String?
  enteredBy        String?
  id               String   @id
  linkedJob        String?
  paidBy           String?
  reimbursableTo   String?
  title            String?
  total            Float
  updatedAt        DateTime
  userEntered      User?    @relation("expensesEnteredByTousers", fields: [enteredBy], references: [id])
  jobs             Job?     @relation(fields: [linkedJob], references: [id])
  userPaid         User?    @relation("expensesPaidByToUsers", fields: [paidBy], references: [id])
  userReimbursable User?    @relation("expensesReimbursableToUsers", fields: [reimbursableTo], references: [id])
}

model Invoice {
  depositAmount             Float
  discountAmount            Float
  invoiceBalance            Float
  paymentsTotal             Float
  subtotal                  Float
  total                     Float
  clientId                  String
  createdAt                 DateTime
  dueDate                   DateTime?
  id                        String           @id
  invoiceNet                Int?
  invoiceNumber             Int
  invoiceStatus             String
  issuedDate                DateTime?
  jobberWebUri              String?
  message                   String?
  receivedDate              DateTime?
  salesperson               String?
  subject                   String
  updatedAt                 DateTime
  legacyDiscountAmount      Float?
  nonTaxAmount              Float?
  taxAmount                 Float?
  tipsTotal                 Float?
  billingStreet             String?
  billingStreet1            String?
  billingStreet2            String?
  billingCity               String?
  billingProvince           String?
  billingPostalCode         String?
  billingCountry            String?
  clientHubUri              String?
  dateViewedInClientHub     DateTime?
  allowReviewRequest        Boolean?
  waitingForFinancedPayment Boolean?
  voidedAt                  DateTime?
  voidReasonCode            String?
  voidReasonDetails         String?
  customFields              Json?
  clients                   Client           @relation(fields: [clientId], references: [id])
  users                     User?            @relation(fields: [salesperson], references: [id])
  jobs                      JobsOnInvoices[]
  payments                  Payment[]
}

model JobsOnInvoices {
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String
  job       Job     @relation(fields: [jobId], references: [id])
  jobId     String

  @@id([invoiceId, jobId])
}

model Job {
  allowReviewRequest                Boolean
  clientId                          String
  completedAt                       DateTime?
  createdAt                         DateTime
  endAt                             DateTime?
  id                                String           @id
  instructions                      String?
  jobNumber                         Int              @unique(map: "jobs_pk")
  jobStatus                         String?
  jobType                           String?
  jobberWebUri                      String?
  property                          String
  salesperson                       String?
  startAt                           DateTime?
  title                             String?
  total                             Float
  uninvoicedTotal                   Float
  updatedAt                         DateTime
  willClientBeAutomaticallyCharged  Boolean
  billingType                       String?
  bookingConfirmationSentAt         DateTime?
  completedAndUninvoicedVisitsCount Int?
  completedAndUninvoicedVisitsTotal Float?
  defaultVisitTitle                 String?
  invoicedTotal                     Float?
  nextDateToSendReviewSms           DateTime?
  source                            String?
  quoteId                           String?
  requestId                         String?
  outstandingAmount                 Float?
  expenseCost                       Float?
  labourCost                        Float?
  labourDuration                    Int?
  lineItemCost                      Float?
  profitAmount                      Float?
  profitPercentage                  Float?
  totalCost                         Float?
  totalRevenue                      Float?
  customFields                      Json?
  expenses                          Expense[]
  invoices                          JobsOnInvoices[]
  quotes                            QuotesOnJobs[]
  clients                           Client           @relation(fields: [clientId], references: [id])
  properties                        Property         @relation(fields: [property], references: [id])
  users                             User?            @relation(fields: [salesperson], references: [id])
  timeSheetEntry                    TimeSheetEntry[]
}

model QuotesOnJobs {
  quote   Quote  @relation(fields: [quoteId], references: [id])
  quoteId String
  job     Job    @relation(fields: [jobId], references: [id])
  jobId   String

  @@id([jobId, quoteId])
}

model Quote {
  depositAmount            Float?
  discountAmount           Float?
  nonTaxAmount             Float?
  outstandingDepositAmount Float?
  subtotal                 Float?
  taxAmount                Float?
  total                    Float?
  clientId                 String
  client                   Client         @relation(fields: [clientId], references: [id])
  clientHubUri             String
  clientHubViewedAt        DateTime?
  contractDisclaimer       String
  createdAt                DateTime
  depositAmountUnallocated Float
  id                       String         @id
  jobberWebUri             String
  // jobs Job?
  jobs                     QuotesOnJobs[]
  approvedAt               DateTime?
  changesRequestedAt       DateTime?
  convertedAt              DateTime?
  message                  String?
  propertyId               String
  property                 Property       @relation(fields: [propertyId], references: [id])
  quoteNumber              Int            @unique(map: "quotes_pk")
  quoteStatus              String
  // request
  salespersonId            String?
  salesperson              User?          @relation(fields: [salespersonId], references: [id])
  totalTaxAmount           Float?
  title                    String?
  sentAt                   DateTime?
  transitionedAt           DateTime?
  eligibleForFinancing     Boolean?
  requestId                String?
  customFields             Json?
  updatedAt                DateTime
}

model Payment {
  adjustmentType   String
  amount           Float
  canEdit          Boolean
  client           String
  details          String
  entryDate        DateTime
  id               String    @id
  invoice          String?
  paymentOrigin    String
  sentAt           DateTime?
  paymentType      String?
  paymentKind      String?
  quote            String?
  tipAmount        Float?
  rawAmount        Float?
  refundableAmount Float?
  clients          Client    @relation(fields: [client], references: [id])
  invoices         Invoice?  @relation(fields: [invoice], references: [id])
}

model Property {
  city             String?
  country          String?
  id               String    @id
  latitude         Float?
  longitude        Float?
  postalCode       String?
  province         String?
  street           String?
  isBillingAddress Boolean
  jobberWebUri     String
  name             String?
  street1          String?
  street2          String?
  routingOrder     Int?
  createdAt        DateTime?
  customFields     Json?
  jobs             Job[]
  client           String
  clients          Client    @relation(fields: [client], references: [id])
  quotes           Quote[]
}

model User {
  createdAt            DateTime
  email                String
  id                   String           @id
  isAccountAdmin       Boolean
  isAccountOwner       Boolean
  name                 String
  phone                String
  status               String
  earnsCommission      Boolean          @default(false)
  commissionPercent    Float            @default(0)
  hourlyRate           Float?
  firstName            String?
  lastName             String?
  assignedColor        String?
  lastLoginAt          DateTime?
  timezone             String?
  uuid                 String?
  addressStreet        String?
  addressCity          String?
  addressProvince      String?
  addressPostalCode    String?
  addressCountry       String?
  customFields         Json?
  // When the row was last refreshed from Jobber (Jobber sends no user webhooks)
  syncedAt             DateTime?
  expensesEntered      Expense[]        @relation("expensesEnteredByTousers")
  expensesPaid         Expense[]        @relation("expensesPaidByToUsers")
  expensesReimbursable Expense[]        @relation("expensesReimbursableToUsers")
  invoices             Invoice[]
  jobs                 Job[]
  quotes               Quote[]
  timeSheets           TimeSheetEntry[] @relation("TimeSheetEntryUserToUser")
  timeSheetPaidBy      TimeSheetEntry[] @relation("PaidByUserToUser")
  timeSheetApprovedBy  TimeSheetEntry[] @relation("ApprovedByToUsers")
}

model TimeSheetEntry {
  approved           Boolean?
  approvedBy         String?
  approvedByUser     User?     @relation("ApprovedByToUsers", fields: [approvedBy], references: [id])
  client             String?
  clients            Client?   @relation("TimeSheetEntryToClient", fields: [client], references: [id])
  createdAt          DateTime?
  endAt              DateTime?
  finalDuration      Int
  id                 String    @id
  job                String?
  jobs               Job?      @relation(fields: [job], references: [id])
  label              String?
  laborRate          Float?
  note               String?
  paidBy             String?
  paidByUser         User?     @relation("PaidByUserToUser", fields: [paidBy], references: [id])
  startAt            DateTime?
  ticking            Boolean?
  updatedAt          DateTime?
  user               String?
  users              User?     @relation("TimeSheetEntryUserToUser", fields: [user], references: [id])
  visit              String?
  payable            Boolean?
  timeSheetCategory  String?
  targetType         String?
  // visits        Visit?    @relation(fields: [visit], references: [id])
  visitDurationTotal Int?
}

// The models below have no foreign keys, so a record can be saved before the
// records it points at (webhooks and backfills arrive in any order).

model Visit {
  id                   String    @id
  jobId                String?
  clientId             String?
  propertyId           String?
  invoiceId            String?
  title                String?
  instructions         String?
  startAt              DateTime?
  endAt                DateTime?
  completedAt          DateTime?
  completedBy          String?
  createdAt            DateTime?
  createdById          String?
  duration             Int?
  allDay               Boolean?
  isComplete           Boolean?
  isRecurring          Boolean?
  isLastScheduledVisit Boolean?
  clientConfirmed      Boolean?
  visitStatus          String?
  arrivalWindowStartAt DateTime?
  arrivalWindowEndAt   DateTime?
  assignedUserIds      String[]

  @@index([jobId])
}

model Request {
  id                String    @id
  clientId          String?
  propertyId        String?
  referringClientId String?
  salespersonId     String?
  title             String?
  companyName       String?
  contactName       String?
  email             String?
  phone             String?
  source            String?
  requestStatus     String?
  isArchivable      Boolean?
  isScheduled       Boolean?
  total             Float?
  jobberWebUri      String?
  createdAt         DateTime?
  updatedAt         DateTime?

  @@index([clientId])
}

/// Line items of quotes, jobs and invoices. `kind` is "quote", "job" or "invoice".
model LineItem {
  id                 String    @id
  kind               String
  quoteId            String?
  jobId              String?
  invoiceId          String?
  productOrServiceId String?
  jobLineItemId      String?
  name               String?
  description        String?
  category           String?
  quantity           Float?
  unitPrice          Float?
  unitCost           Float?
  totalPrice         Float?
  totalCost          Float?
  originalCost       Float?
  markup             Float?
  taxable            Boolean?
  optional           Boolean?
  recommended        Boolean?
  textOnly           Boolean?
  sortOrder          Int?
  date               DateTime?
  createdAt          DateTime?
  updatedAt          DateTime?

  @@index([quoteId])
  @@index([jobId])
  @@index([invoiceId])
}

model ProductOrService {
  id               String   @id
  name             String?
  description      String?
  category         String?
  defaultUnitCost  Float?
  internalUnitCost Float?
  markup           Float?
  durationMinutes  Int?
  taxable          Boolean?
  visible          Boolean?
  customFields     Json?
}

model TwilioNumber {
  id                     String          @id
  phoneNumber            String
  assignedEmployee       String?
  assignedEmployeeNumber String?
  assignedEmployeeName   String?
  twilioContacts         TwilioContact[]
}

model TwilioContact {
  id             String        @id
  twilioNumber   TwilioNumber? @relation(fields: [twilioNumberId], references: [id])
  clientNumber   String
  slackThreadId  String?
  createdAt      DateTime
  lastContactAt  DateTime
  twilioNumberId String?
}

// One Google Ads click conversion per GCLID: the first qualifying CallRail call
// for a click claims the row, and every value restatement for that click is
// routed to this conversion, whichever call the invoice value landed on.
model GoogleAdsClickConversion {
  gclid              String    @id
  transactionId      String? // CallRail call id (CAL…) of the first qualifying call
  conversionDateTime String // exact eventTimestamp sent to Google; restatements must match it to the second
  callStartTime      DateTime // raw CallRail start_time of that call
  uploadedAt         DateTime? // null until Data Manager returns 200
  requestId          String? // Data Manager requestId
  restatedValue      Decimal?  @db.Decimal(12, 2) // total last restated to Google Ads for this click
  restatedCalls      Json? // { [CallRail call id]: value } summed into restatedValue
  restatedAt         DateTime?
  createdAt          DateTime  @default(now())
}

model GoogleAdsAssetCallValue {
  callId             String    @id // CallRail resource_id (CAL…)
  gclid              String
  conversionDateTime String // exact eventTimestamp sent; restatements must match it
  value              Decimal   @db.Decimal(12, 2) // last value sent to Google
  uploadedAt         DateTime? // null until Data Manager returns 200
  requestId          String?
  restatedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([gclid])
}

// One row per form lead: every Google Ads lead form, and every website contact
// form (with or without a Google Ads click ID), so the first contact can carry
// the customer's first invoice value. Organic forms have no click ID and only
// block a later Google Ads contact from getting the value. Phone and email are stored only as
// SHA-256 hashes of their normalized form, just enough to match a Jobber client.
model GoogleAdsLeadFormLead {
  leadId             String    @id // Google lead_id, or "web-<uuid>" for website forms
  source             String    @default("google_lead_form") // google_lead_form | website_form
  conversionAction   String? // value action resource name; null = GOOGLE_ADS_LEAD_FORM_VALUE_CONVERSION_ACTION_ID
  gclid              String?
  gbraid             String? // iOS click IDs, sent when there is no gclid
  wbraid             String?
  phoneHash          String?
  emailHash          String?
  conversionDateTime String // eventTimestamp of the submission; uploads and restatements use it
  value              Decimal?  @db.Decimal(12, 2) // last value sent to Google
  claimedAt          DateTime? // set while an upload is in flight
  uploadedAt         DateTime? // null until Data Manager returns 200
  requestId          String?
  restatedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([phoneHash])
  @@index([emailHash])
}

// Which contact (CallRail call or SMS thread, or form lead) each paid invoice or
// deposit was credited to. A contact's value is the sum of its rows, so a
// diagnostic and the repair that follows add up, and an item is never counted
// twice. A deposit's row is replaced by the invoice it's applied to.
model AdValueAttribution {
  itemId        String    @id // Jobber invoice id, deposit payment id, or "legacy-<contactId>"
  itemKind      String // invoice | deposit | legacy (a value set before this table existed)
  quoteId       String? // a deposit's quote, so the invoice it's applied to can replace it
  clientId      String
  contactKind   String // call | sms | form
  contactId     String // CallRail call or SMS thread id, or GoogleAdsLeadFormLead leadId
  value         Decimal   @db.Decimal(12, 2)
  workStartedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([contactId])
  @@index([quoteId])
}
